# .env.example — SPEC-C1 v2.2 (Camada 1: Fundação)
# Copie para .env e preencha apenas no arquivo local (nunca versione valores).
# Nenhuma variável abaixo tem valor literal; todas são lidas como ${VAR}.

# Cloud API key org-admin (M1, Console): control-plane org/v2, cmk/v2, srcm/v3, fcpm/v2, iam/v2
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Kafka API key cluster-admin (M2, Console): data-plane /kafka/v3 (tópicos, ACLs, listagens)
KAFKA_ADMIN_KEY=
KAFKA_ADMIN_SECRET=

# IDs e endpoints descobertos/gravados pelo setup.sh (não digitar à mão)
CONFLUENT_ENV_ID=
CONFLUENT_KAFKA_CLUSTER_ID=
CONFLUENT_KAFKA_BOOTSTRAP=
CONFLUENT_KAFKA_REST_URL=
CONFLUENT_SR_CLUSTER_ID=
CONFLUENT_SR_URL=
FLINK_POOL_ID=

# API key de cluster do service account desafio-producer (etapa 6 do setup)
KAFKA_KEY_PRODUCER=
KAFKA_SECRET_PRODUCER=

# API key de cluster do service account desafio-consumer (etapa 6 do setup)
KAFKA_KEY_CONSUMER=
KAFKA_SECRET_CONSUMER=

# API key de Schema Registry do service account desafio-producer (etapa 6 do setup)
SR_KEY_PRODUCER=
SR_SECRET_PRODUCER=

# API key de Schema Registry do service account desafio-consumer (etapa 6 do setup)
SR_KEY_CONSUMER=
SR_SECRET_CONSUMER=

# Conexão Postgres (fonte CDC) — Neon ou similar
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_PASSWORD=
