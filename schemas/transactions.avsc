{
  "type": "record",
  "name": "Transaction",
  "namespace": "com.bootcamp.payments",
  "doc": "Card transaction event captured via CDC.",
  "fields": [
    { "name": "transaction_id", "type": "string", "doc": "Primary key." },
    { "name": "card_id", "type": "string" },
    { "name": "account_id", "type": "string" },
    { "name": "merchant_id", "type": "string" },
    {
      "name": "amount",
      "type": { "type": "bytes", "logicalType": "decimal", "precision": 15, "scale": 2 },
      "doc": "Money as decimal(15,2)."
    },
    { "name": "currency", "type": "string" },
    { "name": "transaction_type", "type": { "type": "enum", "name": "TransactionType", "symbols": ["PURCHASE", "REFUND", "WITHDRAWAL"] } },
    { "name": "status", "type": { "type": "enum", "name": "TransactionStatus", "symbols": ["APPROVED", "DECLINED", "PENDING"] } },
    { "name": "created_at", "type": { "type": "long", "logicalType": "timestamp-millis" } }
  ]
}